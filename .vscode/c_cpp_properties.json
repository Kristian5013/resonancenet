{
    "version": 4,
    "configurations": [
        {
            "name": "ResonanceNet",

            // The one line that matters. CMake writes the exact flags it uses for
            // every file — include paths, the language standard, every define —
            // and the extension reads them instead of guessing. Hand-written
            // include paths drift the moment a library is added; this cannot.
            //
            // If it is missing, configure once:  cmake -B build -S .
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",

            // Used only for files the compile database does not mention — a new
            // file before its first configure, or a header opened on its own.
            // Without these the editor falls back to C++17 and underlines
            // std::format, std::span and every designated initializer in the
            // project.
            "cStandard": "c11",
            "cppStandard": "c++26",
            "compilerPath": "/usr/bin/g++",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/third_party"
            ],
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
